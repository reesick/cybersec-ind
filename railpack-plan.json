{
  "packages": {
    "python": "3.13",
    "node": "22"
  },
  "steps": {
    "install": {
      "cmds": [
        "python -m venv /app/.venv",
        "pip install -r requirements.txt"
      ],
      "paths": ["requirements.txt"]
    },
    "build": {
      "cmds": [
        "pip install -r requirements.txt && npm --prefix frontend install --include=dev && npm --prefix frontend run build"
      ],
      "paths": ["."]
    }
  },
  "deploy": {
    "startCmd": "uvicorn api.main:app --host 0.0.0.0 --port $PORT"
  }
}
